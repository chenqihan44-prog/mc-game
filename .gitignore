# Local toolchain, Godot caches, generated builds and test output
.tools/
.godot/
**/bin/
**/obj/
builds/
test-results/

# Editor and operating-system state
.vs/
.idea/
.vscode/
*.user
*.suo
*.userosscache
*.sln.docstates
.DS_Store
Thumbs.db
Desktop.ini

# Local secrets and temporary files
.env
.env.*
!.env.example
!.env.sample
*.pfx
*.p12
*.pem
*.key
*.tmp
*.temp
*.log
*.dmp
**/.saving.lock

# Python cache and Blender automatic backups
__pycache__/
*.py[cod]
*.blend[0-9]*

# Local historical model archive and generated preview galleries
/model-archive/
/docs/previews/*/
!/docs/previews/block-creature-collection-2026-10-13/
/docs/previews/block-creature-collection-2026-10-13/*
!/docs/previews/block-creature-collection-2026-10-13/README.txt
!/docs/previews/block-creature-collection-2026-10-13/manifest.json
!/docs/previews/block-creature-collection-2026-10-13/*/
/docs/previews/block-creature-collection-2026-10-13/*/*
!/docs/previews/block-creature-collection-2026-10-13/*/*.blend
!/docs/previews/block-creature-collection-2026-10-13/*/*.glb
!/docs/previews/block-creature-collection-2026-10-13/*/*-atlas.png
!/docs/previews/block-creature-collection-2026-10-13/*/*-emission.png
!/docs/previews/block-creature-collection-2026-10-13/*/model-record.json
